### ==========================================================
### 15. 강의 결제 / 내 강의 조회 테스트
### 현재 인증 필터는 accessToken 쿠키를 읽으므로 로그인 응답 쿠키를 변수로 저장해 사용합니다.
### ==========================================================

@courseId = 57
@amount = 10000
@portonePaymentId = 1


### 관리자 로그인
POST http://localhost:15000/api/v1/auth/admin/login
Content-Type: application/json
Accept: application/json

{
  "loginId": "super_admin",
  "password": "password123!"
}

> {%
    if (response.status === 200) {
        const setCookie = response.headers.valuesOf
            ? response.headers.valuesOf("Set-Cookie").join("; ")
            : response.headers.valueOf("Set-Cookie");
        const match = setCookie && setCookie.match(/accessToken=([^;]+)/);
        if (match) {
            client.global.set("managerAccessToken", match[1]);
            client.log("관리자 accessToken 저장 완료: " + client.global.get("managerAccessToken"));
        } else {
            client.log("관리자 accessToken 쿠키를 찾지 못했습니다.");
        }
    }
%}


### 일반 사용자 로그인
POST http://localhost:15000/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "username": "test1",
  "password": "test1234"
}

> {%
    if (response.status === 200) {
        const setCookie = response.headers.valuesOf
            ? response.headers.valuesOf("Set-Cookie").join("; ")
            : response.headers.valueOf("Set-Cookie");
        const match = setCookie && setCookie.match(/accessToken=([^;]+)/);
        if (match) {
            client.global.set("userAccessToken", match[1]);
            client.log("사용자 accessToken 저장 완료: " + client.global.get("userAccessToken"));
        } else {
            client.log("사용자 accessToken 쿠키를 찾지 못했습니다.");
        }
    }
%}


### 강의 공개 상태로 수정
PUT http://localhost:15000/api/v1/admin/courses/{{courseId}}
Authorization: Bearer {{managerAccessToken}}
Cookie: accessToken={{managerAccessToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="request"
Content-Type: application/json

{
  "title": "테스트 강의",
  "description": "공개 상태 테스트",
  "price": {{amount}},
  "level": "BEGINNER",
  "status": "PUBLISHED"
}

--boundary--


### 사용자 강의 상세 조회 - 결제 전 상태 확인
GET http://localhost:15000/api/v1/courses/{{courseId}}
Cookie: accessToken={{userAccessToken}}
Accept: application/json


### 사용자 강의 목록 조회 - 결제 전 상태 확인
GET http://localhost:15000/api/v1/courses/countries/1
Cookie: accessToken={{userAccessToken}}
Accept: application/json


### 강의 단독 결제
### portonePaymentId는 실제 PortOne 성공 결제 ID로 변경해야 정상 처리됩니다.
POST http://localhost:15000/api/v1/payments/lecture
Cookie: accessToken={{userAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "courseId": {{courseId}},
  "amount": {{amount}},
  "usedMileage": 0,
  "usedCouponId": null,
  "portonePaymentId": "{{portonePaymentId}}"
}


### 내 수강 강의 목록 조회
GET http://localhost:15000/api/v1/my/courses
Cookie: accessToken={{userAccessToken}}
Accept: application/json


### 내 수강 강의 상세 조회
GET http://localhost:15000/api/v1/my/courses/{{courseId}}
Cookie: accessToken={{userAccessToken}}
Accept: application/json


### 내 결제 내역 조회
GET http://localhost:15000/api/v1/payments/me
Cookie: accessToken={{userAccessToken}}
Accept: application/json
