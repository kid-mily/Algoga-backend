### ==========================================================
### 07. Coupon policy and course reward tests
###
### Run order
### 1) Login as content manager
### 2) Login as user
### 3) Create/list/update/delete coupon policy
### 4) Grant course reward after completion and quiz submission
### ==========================================================

@host = http://localhost:15000
@courseId = 54
@couponPolicyId = 16


### Content manager login
POST {{host}}/api/v1/auth/admin/login
Content-Type: application/json
Accept: application/json

{
  "loginId": "content_manager_01",
  "password": "password123"
}

> {%
    if (response.status === 200) {
        client.global.set("managerAccessToken", response.body.data.accessToken);
        client.log("managerAccessToken saved");
    } else {
        client.global.clear("managerAccessToken");
        client.log("manager login failed; stale token cleared");
    }
%}


### User login
POST {{host}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "username": "test1",
  "password": "test1234"
}

> {%
    if (response.status === 200) {
        client.global.set("userAccessToken", response.body.data.accessToken);
        client.global.set("userRefreshToken", response.body.data.refreshToken);
        client.log("userAccessToken saved");
    }
%}


### Create coupon policy - admin
POST {{host}}/api/v1/admin/courses/{{courseId}}/coupon-policies
Authorization: Bearer {{managerAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "couponName": "Course completion  discount coupon22",
  "discountType": "RATE",
  "discountValue": 10
}


### Get active coupon policies - admin
GET {{host}}/api/v1/admin/courses/{{courseId}}/coupon-policies
Authorization: Bearer {{managerAccessToken}}
Accept: application/json


### Update coupon policy - admin
PUT {{host}}/api/v1/admin/courses/{{courseId}}/coupon-policies/{{couponPolicyId}}
Authorization: Bearer {{managerAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "couponName": "Updated course completion discount coupon",
  "discountType": "RATE",
  "discountValue": 15
}


### Update coupon policy - duplicate name failure
PUT {{host}}/api/v1/admin/courses/{{courseId}}/coupon-policies/{{couponPolicyId}}
Authorization: Bearer {{managerAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "couponName": "Course completion discount coupon",
  "discountType": "RATE",
  "discountValue": 15
}


### Delete coupon policy - admin
### This is soft delete: is_active=false.
DELETE {{host}}/api/v1/admin/courses/{{courseId}}/coupon-policies/{{couponPolicyId}}
Authorization: Bearer {{managerAccessToken}}
Accept: application/json


### Get active coupon policies after delete - admin
GET {{host}}/api/v1/admin/courses/{{courseId}}/coupon-policies
Authorization: Bearer {{managerAccessToken}}
Accept: application/json


### Grant reward - user
### Requires enrollment, course completion, and quiz submission for the same user/course.
POST {{host}}/api/v1/courses/{{courseId}}/rewards
Authorization: Bearer {{userAccessToken}}
Accept: application/json
