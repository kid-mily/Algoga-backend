### ==========================================================
### 17. 관리자 강의 보상 실패 관리
### 실행 순서:
### 1. Content manager login 먼저 실행
### 2. 아래 로그에 managerAccessToken saved 출력 확인
### 3. 실패 목록 조회 실행
### 4. 조회 응답의 failureId로 재시도 실행
### ==========================================================

@host = http://localhost:15000


### Content manager login - 먼저 실행
POST {{host}}/api/v1/auth/admin/login
Content-Type: application/json
Accept: application/json

{
  "loginId": "content_manager_01",
  "password": "password123"
}

> {%
    let token = null;

    const setCookie = response.headers.valuesOf
        ? response.headers.valuesOf("Set-Cookie").join("; ")
        : response.headers.valueOf("Set-Cookie");

    const match = setCookie && setCookie.match(/adminAccessToken=([^;]+)/);

    if (match) {
        token = match[1];
    }

    if (response.status === 200 && token) {
        client.global.set("managerAccessToken", token);
        client.log("managerAccessToken saved: " + client.global.get("managerAccessToken"));
    } else {
        client.global.clear("managerAccessToken");
        client.log("managerAccessToken not found.");
        client.log("status: " + response.status);
        client.log("Set-Cookie: " + setCookie);
    }
%}


### 강의 보상 실패 목록 조회 - PENDING
GET {{host}}/api/v1/admin/course-reward-failures?status=PENDING
Authorization: Bearer {{managerAccessToken}}
Cookie: adminAccessToken={{managerAccessToken}}
Accept: application/json


### 강의 보상 실패 목록 조회 - FAILED
GET {{host}}/api/v1/admin/course-reward-failures?status=FAILED
Authorization: Bearer {{managerAccessToken}}
Cookie: adminAccessToken={{managerAccessToken}}
Accept: application/json


### 강의 보상 실패 목록 조회 - RESOLVED
GET {{host}}/api/v1/admin/course-reward-failures?status=RESOLVED
Authorization: Bearer {{managerAccessToken}}
Cookie: adminAccessToken={{managerAccessToken}}
Accept: application/json


### 강의 보상 실패 재시도
### 위 목록 조회 응답의 failureId로 1을 바꿔서 실행
POST {{host}}/api/v1/admin/course-reward-failures/3/retry
Authorization: Bearer {{managerAccessToken}}
Cookie: adminAccessToken={{managerAccessToken}}
Accept: application/json