### ==========================================================
### 13. 진단평가 / 추천 강의
### 사용자 API는 로그인 응답의 accessToken 쿠키를 userAccessToken에 저장해서 사용합니다.
### 관리자 API는 아래 관리자 로그인 응답의 accessToken 쿠키를 managerAccessToken에 저장해서 사용합니다.
### ==========================================================

### 일반 사용자 로그인
POST http://localhost:15000/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "username": "test1",
  "password": "test1234"
}

> {%
    if (response.status === 200) {
        const setCookie = response.headers.valuesOf
            ? response.headers.valuesOf("Set-Cookie").join("; ")
            : response.headers.valueOf("Set-Cookie");
        const match = setCookie && setCookie.match(/accessToken=([^;]+)/);
        if (match) {
            client.global.set("userAccessToken", match[1]);
            client.log("사용자 accessToken 저장 완료: " + client.global.get("userAccessToken"));
        } else {
            client.log("accessToken 쿠키를 찾지 못했습니다.");
        }
    }
%}



### 비로그인 진단평가 문항 조회 확인
### 기대 결과: 401 / LMS_039
GET http://localhost:15000/api/v1/diagnosis/questions?countryId=1
Accept: application/json


### 로그인 진단평가 문항 조회
### 기대 결과: 200
GET http://localhost:15000/api/v1/diagnosis/questions?countryId=1
Cookie: accessToken={{userAccessToken}}
Accept: application/json


### 비로그인 진단평가 결과 제출 확인
### 기대 결과: 401 / LMS_039
POST http://localhost:15000/api/v1/diagnosis/result
Content-Type: application/json
Accept: application/json

{
  "countryId": 1,
  "answers": [
    {
      "questionId": 1,
      "selectedOption": 2
    }
  ]
}


### 로그인 진단평가 결과 제출
### questionId는 문항 조회 응답의 실제 ID로 변경해서 테스트하세요.
POST http://localhost:15000/api/v1/diagnosis/result
Cookie: accessToken={{userAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "countryId": 1,
  "answers": [
    {
      "questionId": 1,
      "selectedOption": 2
    },
    {
      "questionId": 2,
      "selectedOption": 3
    },
    {
      "questionId": 3,
      "selectedOption": 1
    },
    {
      "questionId": 4,
      "selectedOption": 2
    },
    {
      "questionId": 5,
      "selectedOption": 1
    }
  ]
}


### 내 최신 진단평가 결과 조회
GET http://localhost:15000/api/v1/diagnosis/me/latest
Cookie: accessToken={{userAccessToken}}
Accept: application/json


### 진단평가 추천 강의 조회 - 초급
GET http://localhost:15000/api/v1/diagnosis/recommendations?countryId=1&level=BEGINNER
Accept: application/json


### 진단평가 추천 강의 조회 - 중급
GET http://localhost:15000/api/v1/diagnosis/recommendations?countryId=1&level=INTERMEDIATE
Accept: application/json


### 진단평가 추천 강의 조회 - 고급
GET http://localhost:15000/api/v1/diagnosis/recommendations?countryId=1&level=ADVANCED
Accept: application/json


### 진단평가 결과 재제출
POST http://localhost:15000/api/v1/diagnosis/result
Cookie: accessToken={{userAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "countryId": 1,
  "answers": [
    {
      "questionId": 1,
      "selectedOption": 1
    },
    {
      "questionId": 2,
      "selectedOption": 1
    },
    {
      "questionId": 3,
      "selectedOption": 1
    },
    {
      "questionId": 4,
      "selectedOption": 1
    },
    {
      "questionId": 5,
      "selectedOption": 1
    }
  ]
}


### 재제출 후 내 최신 진단평가 결과 조회
GET http://localhost:15000/api/v1/diagnosis/me/latest
Cookie: accessToken={{userAccessToken}}
Accept: application/json


### 관리자 진단평가 문항 목록 조회
GET http://localhost:15000/api/v1/admin/diagnosis/questions?countryId=1
Authorization: Bearer {{managerAccessToken}}
Cookie: accessToken={{managerAccessToken}}
Accept: application/json


### 관리자 진단평가 문항 등록
POST http://localhost:15000/api/v1/admin/diagnosis/questions
Authorization: Bearer {{managerAccessToken}}
Cookie: accessToken={{managerAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "countryId": 1,
  "questionText": "일본 여행 전 꼭 확인해야 할 것은?",
  "option1": "여권",
  "option2": "항공권",
  "option3": "숙소 예약",
  "option4": "모두",
  "correctOption": 4,
  "explanation": "해외 여행 전에는 여권, 항공권, 숙소 예약을 모두 확인해야 합니다.",
  "questionOrder": 1,
  "active": true
}


### 관리자 진단평가 문항 수정
### questionId를 실제 문항 ID로 변경해서 테스트하세요.
PUT http://localhost:15000/api/v1/admin/diagnosis/questions/1
Authorization: Bearer {{managerAccessToken}}
Cookie: accessToken={{managerAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "questionText": "일본 여행 전 필수 준비물로 가장 적절한 것은?",
  "option1": "여권",
  "option2": "항공권",
  "option3": "숙소 예약 확인서",
  "option4": "모두",
  "correctOption": 4,
  "explanation": "해외 여행 전에는 여권, 항공권, 숙소 예약 확인서가 모두 필요합니다.",
  "questionOrder": 1,
  "active": true
}


### 관리자 진단평가 문항 삭제
### 정책: 진단평가는 soft delete 없이 즉시 삭제
DELETE http://localhost:15000/api/v1/admin/diagnosis/questions/1
Authorization: Bearer {{managerAccessToken}}
Cookie: accessToken={{managerAccessToken}}
Accept: application/json


### 관리자 진단평가 결과 전체 조회
GET http://localhost:15000/api/v1/admin/diagnosis/results
Authorization: Bearer {{managerAccessToken}}
Cookie: accessToken={{managerAccessToken}}
Accept: application/json


### 관리자 진단평가 결과 사용자별 조회
GET http://localhost:15000/api/v1/admin/diagnosis/results?userId=2
Authorization: Bearer {{managerAccessToken}}
Cookie: accessToken={{managerAccessToken}}
Accept: application/json


### 관리자 진단평가 결과 국가별 조회
GET http://localhost:15000/api/v1/admin/diagnosis/results?countryId=1
Authorization: Bearer {{managerAccessToken}}
Cookie: accessToken={{managerAccessToken}}
Accept: application/json
