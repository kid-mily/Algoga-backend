#        client.global.set("authToken", response.body.data.accessToken);
#    }
#%}

### 3. 내 프로필 정보 업데이트 (이미지 포함 multipart 요청)
PATCH http://localhost:15000/api/v1/users/me
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="nickname"

하연변경닉네임
--WebAppBoundary
Content-Disposition: form-data; name="phone"

010-3424-6542
--WebAppBoundary
Content-Disposition: form-data; name="email"

new_email@gmail.com
--WebAppBoundary
Content-Disposition: form-data; name="profileImage"; filename="큐알.jpg"
Content-Type: image/jpeg

< ./큐알.jpg
--WebAppBoundary--

> {%
    // 프로필 수정 성공 시 새로운 토큰으로 교체!
    if (response.status === 200) {
        client.global.set("authToken", response.body.data.accessToken);
    }
%}

### 4. 비밀번호 변경
PATCH http://localhost:15000/api/v1/users/me/password
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "currentPassword": "password8888",
  "newPassword": "newpassword8888"
}