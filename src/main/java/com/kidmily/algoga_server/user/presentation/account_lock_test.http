### [변수 설정]
@host = http://localhost:15000

### 0. 테스트용 계정 회원가입 (최초 1회만 실행하면 됨. 재실행 시 중복 에러나면 그냥 건너뛰기)
POST {{host}}/api/v1/auth/signup
Content-Type: application/json

{
  "username": "locktest01",
  "email": "locktest01@algoga.com",
  "password": "password123",
  "name": "잠금테스트",
  "phone": "010-2353-6666",
  "birthDate": "2000-01-01",
  "gender": "MALE",
  "nickname": "잠금테스트",
  "termsServiceAgreed": true,
  "termsPrivacyAgreed": true,
  "termsMarketingAgreed": false
}

### 1. 비밀번호 틀린 로그인 시도 #1 -> 400 INVALID_PASSWORD (USER_006) 기대
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "locktest01",
  "password": "wrong-password"
}

> {%
    client.test("1회차: 400 INVALID_PASSWORD", function () {
        client.assert(response.status === 400, "상태 코드가 400이 아닙니다: " + response.status);
        client.assert(response.body.errorCode === "USER_006", "errorCode가 USER_006이 아닙니다: " + response.body.errorCode);
    });
%}

