### 1. 일반 회원가입 (POST /api/v1/auth/signup)
# - 정상적인 데이터를 넣어서 가입이 잘 되는지 확인합니다.
POST http://localhost:15000/api/v1/auth/signup
Content-Type: application/json
Accept: application/json

{
  "username": "gkdus",
  "email": "testuser88@algoga.com",
  "password": "password12345",
  "name": "이하연",
  "phone": "010-8888-9999",
  "birthDate": "1995-05-15",
  "gender": "MALE",
  "nickname": "하연하연",
  "referralCode": "REF002",
  "signupPath": "인스타그램"
}

> {%
    // 응답이 오면 상태 코드와 결과를 콘솔에 출력합니다.
    client.test("회원가입 성공 여부 확인", function() {
        client.assert(response.status === 201, "상태 코드가 201이 아닙니다.");
        client.log("응답 메시지: " + response.body.message);
    });
%}

### ------------------------------------------------------------------------

### 2. 일반 회원가입 - 이메일 중복 에러 테스트
# - 1번에서 가입한 똑같은 이메일로 다시 가입을 시도해서 에러(409)가 나는지 확인합니다.
POST http://localhost:15000/api/v1/auth/signup
Content-Type: application/json
Accept: application/json

{
  "username": "gkdus",
  "email": "testuser88@algoga.com",
  "password": "password12345",
  "name": "이하연",
  "phone": "010-8888-9999",
  "birthDate": "1995-05-15",
  "gender": "MALE",
  "nickname": "하연하연"
}

### ------------------------------------------------------------------------

### 3. 일반 로그인 (POST /api/v1/auth/login)
# - 1번에서 가입한 정보로 로그인을 시도합니다.
# - 로그인이 성공하면 발급받은 accessToken과 refreshToken을 변수에 자동 저장합니다.
POST http://localhost:15000/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "username": "gkdus",
  "password": "password12345"
}

> {%
    // 로그인 응답으로 온 토큰을 인텔리제이 메모리에 임시로 저장합니다.
    if(response.status === 200) {
        client.global.set("accessToken", response.body.data.accessToken);
        client.global.set("refreshToken", response.body.data.refreshToken);
        client.log("Access Token: " + client.global.get("accessToken"));
    }
%}

### ------------------------------------------------------------------------

### 4. 권한이 필요한 API 테스트 (예시: 마이페이지 - 구현 예정)
# - 3번 로그인에서 저장한 {{accessToken}}을 헤더에 넣어서 요청이 잘 통과하는지 확인합니다.
GET http://localhost:15000/api/v1/users/me
Accept: application/json
Authorization: Bearer {{accessToken}}


### 5. 아이디 찾기 (이름과 이메일로 마스킹된 아이디 조회)
POST http://localhost:15000/api/v1/auth/find-id
Content-Type: application/json

{
  "name": "이하연",
  "email": "testuser88@algoga.com"
}

### ------------------------------------------------------------------------

### 6. 비밀번호 찾기 (임시 비밀번호 발급)
# 이 요청을 보내고, 인텔리제이 'Run' 탭 콘솔 로그를 확인하세요!
# 로그에 "임시 비밀번호가 발급되었습니다..."가 뜰 거예요.
POST http://localhost:15000/api/v1/auth/find-password
Content-Type: application/json

{
  "username": "gkdus",
  "email": "testuser88@algoga.com"
}

### ------------------------------------------------------------------------

### 7. 임시 비밀번호로 로그인
# 콘솔 로그에서 확인한 임시 비밀번호를 여기에 넣으세요!
POST http://localhost:15000/api/v1/auth/login
Content-Type: application/json

{
  "username": "gkdus",
  "password": "ce4da01a"
}