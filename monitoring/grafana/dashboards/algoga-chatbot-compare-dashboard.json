{
  "title": "🚀 Algoga Chatbot - DB vs Vector 성능 및 자원 비교",
  "uid": "algoga-perf-compare-v2",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "⏱️ 1. 검색 지연시간 비교 (p95): MySQL vs Redis Vector DB",
      "type": "timeseries",
      "description": "k6 부하 증가 시 MySQL(Brute-force)과 Redis Vector(HNSW)의 응답 시간(Latency) 차이를 비교합니다.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "histogram_quantile(0.95, sum(rate(algoga_chatbot_search_time_seconds_bucket{scenario=\"mysql\"}[1m])) by (le))",
          "legendFormat": "🔴 MySQL 연산 지연 (p95)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "histogram_quantile(0.95, sum(rate(algoga_chatbot_search_time_seconds_bucket{scenario=\"vector\"}[1m])) by (le))",
          "legendFormat": "🟢 Redis Vector 검색 지연 (p95)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 2,
      "title": "🔥 2. CPU 사용량 (System vs Spring Boot Process)",
      "type": "timeseries",
      "description": "MySQL의 1만건 벡터 연산 부하와 Redis DB의 메모리 연산 부하가 서버 CPU에 미치는 영향을 측정합니다.",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 9 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "system_cpu_usage{application=\"algoga-server\"}",
          "legendFormat": "전체 시스템 CPU"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "process_cpu_usage{application=\"algoga-server\"}",
          "legendFormat": "Spring Boot 프로세스 CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        }
      }
    },
    {
      "id": 3,
      "title": "💾 3. JVM Heap 메모리 사용량",
      "type": "timeseries",
      "description": "부하 테스트 중 메모리 누수(Memory Leak)가 없는지, 가비지 컬렉션(GC)이 정상 작동하는지 확인합니다.",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 9 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(jvm_memory_used_bytes{application=\"algoga-server\", area=\"heap\"})",
          "legendFormat": "사용 중인 Heap 메모리 (Used)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(jvm_memory_max_bytes{application=\"algoga-server\", area=\"heap\"})",
          "legendFormat": "최대 할당 가능 메모리 (Max)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 30 }
        }
      }
    }
  ]
}