{
  "title": "Algoga User Domain Business Metrics",
  "uid": "algoga-user-business",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "timezone": "Asia/Seoul",
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "📊 User 도메인 비즈니스 지표",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "누적 회원가입 수",
      "type": "stat",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(algoga_user_signup_total)",
          "legendFormat": "가입자 수"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "title": "누적 탈퇴 수",
      "type": "stat",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(algoga_user_withdraw_total)",
          "legendFormat": "탈퇴 수"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 3,
      "title": "로그인 실패율 (%)",
      "type": "stat",
      "description": "최근 구간 동안의 로그인 시도 중 실패(탈퇴/잠금/블랙리스트/비밀번호 오류) 비율",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "100 * sum(rate(algoga_user_login_total{result=\"failed\"}[$__rate_interval])) / sum(rate(algoga_user_login_total[$__rate_interval]))",
          "legendFormat": "실패율"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 40 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "누적 로그인 시도 수",
      "type": "stat",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(algoga_user_login_total)",
          "legendFormat": "로그인 시도"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5,
      "title": "회원가입 추이 (소셜 타입별)",
      "type": "timeseries",
      "description": "LOCAL(일반)/GOOGLE/KAKAO 가입 경로별 추이",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum by (socialType) (rate(algoga_user_signup_total[$__rate_interval]))",
          "legendFormat": "{{socialType}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "title": "로그인 성공/실패 추이",
      "type": "timeseries",
      "description": "HTTP 상태코드(200/500) 기준이 아니라, 실제 비즈니스 로직상 성공/실패(401/403/409 등 포함)를 정확히 집계한 지표",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum by (result) (rate(algoga_user_login_total[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    }
  ]
}
