{
  "title": "Algoga Chat Rooms",
  "uid": "algoga-chat-rooms",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "채팅방 목록 조회 API 응답 성능",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 1,
      "title": "채팅방 목록 조회 TPS",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/chat/rooms\", status=\"200\"}[1m]))",
          "legendFormat": "성공 TPS"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/chat/rooms\", status=~\"4..|5..\"}[1m]))",
          "legendFormat": "에러 TPS"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 2,
      "title": "채팅방 목록 조회 응답시간 (p50 / p95 / p99)",
      "type": "timeseries",
      "description": "캐시 적용 전/후 p95 변화를 여기서 비교합니다.",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{uri=\"/api/v1/chat/rooms\"}[$__rate_interval]))",
          "legendFormat": "p99"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{uri=\"/api/v1/chat/rooms\"}[$__rate_interval]))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "histogram_quantile(0.50, rate(http_server_requests_seconds_bucket{uri=\"/api/v1/chat/rooms\"}[$__rate_interval]))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "title": "에러율 (%)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/chat/rooms\", status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/chat/rooms\"}[1m])), 0.001) * 100",
          "legendFormat": "5xx 에러율"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "DB 커넥션 풀 (N+1 영향도 관찰)",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 4,
      "title": "DB 커넥션 풀 상태",
      "description": "부하 중 Active 커넥션이 급증하면 N+1 쿼리가 DB를 압박하는 신호입니다.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "hikaricp_connections_active",
          "legendFormat": "Active"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "hikaricp_connections_idle",
          "legendFormat": "Idle"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "hikaricp_connections_pending",
          "legendFormat": "Pending (대기)"
        }
      ]
    },
    {
      "id": 5,
      "title": "DB 커넥션 획득 대기시간 (p95)",
      "description": "Pending이 발생하면 이 값이 올라갑니다. N+1로 커넥션이 고갈되는 상황을 감지합니다.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "histogram_quantile(0.95, rate(hikaricp_connections_acquire_seconds_bucket[$__rate_interval]))",
          "legendFormat": "획득 대기 p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 102,
      "type": "row",
      "title": "인프라",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 6,
      "title": "JVM Heap 사용량",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 7,
      "title": "JVM GC Pause 시간",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "rate(jvm_gc_pause_seconds_sum[1m])",
          "legendFormat": "{{gc}} - {{action}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 103,
      "type": "row",
      "title": "로그",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 8,
      "title": "채팅 도메인 실시간 로그 (Loki)",
      "type": "logs",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 10 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki_ds" },
          "expr": "{job=\"algoga-server\"} |= \"/api/v1/chat/rooms\"",
          "legendFormat": ""
        }
      ],
      "options": { "showTime": true, "showLabels": false, "sortOrder": "Descending" }
    },
    {
      "id": 104,
      "type": "row",
      "title": "실시간 연결 (WebSocket / STOMP)",
      "gridPos": { "x": 0, "y": 38, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 9,
      "title": "현재 동시 접속 수",
      "description": "algoga_friend_online_users — 인증된 WebSocket 세션 수 (탭 여러 개면 중복 카운트). 채팅 실시간의 심박수.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 39, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(algoga_friend_online_users)",
          "legendFormat": "동시 접속"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 10,
      "title": "동시 접속 수 추이",
      "description": "급감 = 서버 재시작/네트워크 장애 신호. Heap·GC 패널과 함께 보면 연결 급증→메모리 상승을 상관 분석할 수 있습니다.",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 39, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(algoga_friend_online_users)",
          "legendFormat": "동시 접속"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } }
    },
    {
      "id": 11,
      "title": "연결 / 해제 rate (초당)",
      "description": "해제 rate 스파이크 = 배포/서버 튕김/네트워크 장애로 대량 disconnect가 발생한 신호. 정상 이탈과 구분됩니다.",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 39, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(algoga_chat_ws_connection_total{event=\"connect\"}[1m]))",
          "legendFormat": "연결/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(algoga_chat_ws_connection_total{event=\"disconnect\"}[1m]))",
          "legendFormat": "해제/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 } }
    },
    {
      "id": 105,
      "type": "row",
      "title": "브로커 채널 (SimpleBroker 백프레셔)",
      "gridPos": { "x": 0, "y": 47, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 12,
      "title": "채널 큐 적체 (queued tasks)",
      "description": "핵심 지표. 인메모리 SimpleBroker가 처리 속도를 못 따라가면 이 큐가 쌓입니다. 정상은 0 근처, 지속적으로 >0 이면 메시지 처리 지연/적체 신호.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 48, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "executor_queued_tasks{name=\"clientInboundChannelExecutor\"}",
          "legendFormat": "inbound 큐"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "executor_queued_tasks{name=\"clientOutboundChannelExecutor\"}",
          "legendFormat": "outbound 큐"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "executor_queued_tasks{name=\"brokerChannelExecutor\"}",
          "legendFormat": "broker 큐"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "title": "채널 활성 스레드 / 풀 크기",
      "description": "active 스레드가 pool 크기에 계속 붙어 있으면 스레드가 포화된 상태 → 큐 적체로 이어집니다.",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 48, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "executor_active_threads{name=~\"client(Inbound|Outbound)ChannelExecutor|brokerChannelExecutor\"}",
          "legendFormat": "{{name}} active"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "executor_pool_size{name=~\"client(Inbound|Outbound)ChannelExecutor|brokerChannelExecutor\"}",
          "legendFormat": "{{name}} pool"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } }
    },
    {
      "id": 14,
      "title": "채널 처리량 (완료 tasks/s)",
      "description": "각 채널이 초당 몇 개의 메시지 작업을 처리하는지. 큐는 쌓이는데 처리량이 안 오르면 병목 확정.",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 48, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum by (name) (rate(executor_completed_tasks_total{name=~\"client(Inbound|Outbound)ChannelExecutor|brokerChannelExecutor\"}[1m]))",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 } }
    }
  ]
}