{
  "title": "Algoga User Domain Dashboard",
  "uid": "algoga-user-dashboard",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "Asia/Seoul",
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "⚡ User Performance Metrics (로그인 성능 및 CPU 부하)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "로그인 API 초당 처리 수 (TPS)",
      "type": "timeseries",
      "description": "k6 가상 유저(VU) 유입 시 실시간으로 소화하는 로그인 API 트래픽 양입니다.",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/auth/login\"}[1m]))",
          "legendFormat": "로그인 TPS"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 2,
      "title": "로그인 응답 시간 (p50 / p95 / p99)",
      "type": "timeseries",
      "description": "Bcrypt 연산으로 인한 지연을 백분위수로 정밀하게 측정합니다. (p95 최적화 지표)",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{uri=\"/api/v1/auth/login\"}[$__rate_interval]))",
          "legendFormat": "p99 (상위 1% 지연)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{uri=\"/api/v1/auth/login\"}[$__rate_interval]))",
          "legendFormat": "p95 (기준선)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "histogram_quantile(0.50, rate(http_server_requests_seconds_bucket{uri=\"/api/v1/auth/login\"}[$__rate_interval]))",
          "legendFormat": "p50 (평균 체감)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "title": "애플리케이션 CPU 사용량 (Bcrypt 피크 타임 감지)",
      "type": "timeseries",
      "description": "로그인 요청 시 Bcrypt 암호화 알고리즘에 의해 Java 프로세스의 CPU 점유율이 얼마나 치솟는지 관측합니다.",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 7 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "system_cpu_usage * 100",
          "legendFormat": "전체 시스템 CPU (%)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "process_cpu_usage * 100",
          "legendFormat": "스프링 부트 프로세스 CPU (%)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "id": 200,
      "type": "row",
      "title": "🔐 Authentication Security (인증 보안 및 비정상 접근)",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "title": "로그인 시도 현황 (정상 vs 실패)",
      "type": "timeseries",
      "description": "정상 로그인(200)과 실패(4xx) 트래픽을 비교합니다. 실패가 급증하면 무차별 대입 공격(Brute-force)을 의심합니다.",
      "gridPos": { "x": 0, "y": 17, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/auth/login\", status=\"200\"}[1m]))",
          "legendFormat": "로그인 성공 (200)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/auth/login\", status=~\"4..\"}[1m]))",
          "legendFormat": "로그인 실패 (4xx)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 5,
      "title": "비정상적 권한 접근 시도 (401 / 403)",
      "type": "timeseries",
      "description": "토큰 없이 접근하거나 권한이 없는 API를 찌르는 악의적인 트래픽을 감지합니다.",
      "gridPos": { "x": 12, "y": 17, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(http_server_requests_seconds_count{status=\"401\"}[1m]))",
          "legendFormat": "401 (토큰 없음/만료)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(http_server_requests_seconds_count{status=\"403\"}[1m]))",
          "legendFormat": "403 (권한 부족)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 300,
      "type": "row",
      "title": "📈 User Onboarding Funnel (회원가입 퍼널 및 이탈률)",
      "gridPos": { "x": 0, "y": 25, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "title": "이메일 인증 퍼널 (발송 vs 검증 완료)",
      "type": "timeseries",
      "description": "인증번호 발송 후 실제 검증까지 완료한 유저의 비율을 모니터링합니다.",
      "gridPos": { "x": 0, "y": 26, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/auth/email/send\", status=\"200\"}[1m]))",
          "legendFormat": "인증번호 발송 요청"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/auth/email/verify\", status=\"200\"}[1m]))",
          "legendFormat": "인증번호 검증 성공"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 7,
      "title": "신규 회원가입 및 서비스 탈퇴 추이",
      "type": "timeseries",
      "description": "서비스에 유입되는 유저와 이탈(탈퇴)하는 유저의 트래픽을 비교합니다.",
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/auth/signup\", status=\"200\"}[1m]))",
          "legendFormat": "회원가입 완료"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/users/me\", method=\"DELETE\", status=\"200\"}[1m]))",
          "legendFormat": "회원 탈퇴 처리"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 400,
      "type": "row",
      "title": "📋 Exception Logs (인증/인가 실패 실시간 로그)",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "title": "AuthException / UserException 로그",
      "type": "logs",
      "gridPos": { "x": 0, "y": 35, "w": 24, "h": 10 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki_ds" },
          "expr": "{job=\"algoga-server\"} |= \"AuthException\" or |= \"UserException\"",
          "legendFormat": ""
        }
      ],
      "options": { "showTime": true, "showLabels": false, "sortOrder": "Descending" }
    }
  ]
}